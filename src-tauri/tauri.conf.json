{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Desktop",
  "version": "0.1.0",
  "identifier": "com.danilo.chatgptdesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Cliente desktop Linux independente para acessar o ChatGPT Web (https://chatgpt.com). Não é um aplicativo oficial da OpenAI.",
    "shortDescription": "Cliente desktop Linux para ChatGPT Web",
    "category": "Utility",
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional"
      },
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    }
  }
}
